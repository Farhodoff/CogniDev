{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CogniDev",
  "version": "0.2.7",
  "identifier": "com.cognidev.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CogniDev",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "The AI-Powered Developer Command Center & Second Brain",
    "longDescription": "CogniDev centralizes engineering logs, bugs, team squads, and AI chat context in a local-first engineering cockpit.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:synapse.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MzdBQTJFMDYxMEE5QzYKUldUR3FSQUdMcW8zR1FTZ3V6TzJkZXZmSTdxV3B1S0FlSzFyRjFLVy8ydnlHVWZZS0JlQVZSbmcK",
      "endpoints": [
        "https://github.com/Farhodoff/CogniDev/releases/latest/download/latest.json"
      ]
    }
  }
}
